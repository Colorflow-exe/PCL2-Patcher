<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PCL2Patch</AssemblyName>
        <RootNamespace>PCL2Patch.Gui</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>PCL2Patch</Product>
    <AssemblyTitle>PCL2Patch</AssemblyTitle>
    <Company>Colorflow-exe</Company>
    <Copyright>Copyright © 2026 Colorflow-exe</Copyright>
    <Description>PCL2 下载/安装限制解除补丁工具</Description>
    <StartupObject>PCL2Patch.Gui.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCL2Patch.Core\PCL2Patch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
