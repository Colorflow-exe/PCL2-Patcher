<ui:FluentWindow x:Class="PCL2Patch.Gui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="PCL2Patch"
                 Width="840" Height="560"
                 MinWidth="720" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="PCL2Patch" ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="28,12,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText" Text="PCL2 限制解除补丁" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="DescText" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                    <TextBlock x:Name="ThemeLabel" Text="主题" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ThemeBox" Width="118" SelectionChanged="ThemeBox_SelectionChanged" />
                    <TextBlock x:Name="LanguageLabel" Text="语言" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <ComboBox x:Name="LanguageBox" Width="96" SelectionChanged="LanguageBox_SelectionChanged" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ProgramLabel" Grid.Column="0" Text="PCL2 程序" VerticalAlignment="Center" />
                <ui:TextBox x:Name="OfficialBox" Grid.Column="1" Margin="0,0,8,0" />
                <ui:Button x:Name="BrowseProgramButton" Grid.Column="2" Content="浏览…" Click="BrowseOfficial_Click" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="PatchButton" Grid.Column="0" Content="开始修补" Height="38"
                           Appearance="Primary" Click="Patch_Click" />
                <ui:Button x:Name="RestoreButton" Grid.Column="1" Content="恢复原版" Height="38"
                           Margin="10,0,0,0" Click="Restore_Click" />
            </Grid>

            <TextBox x:Name="LogBox" Grid.Row="3" Margin="0,16,0,12"
                     IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     Background="Transparent" BorderThickness="0" TextWrapping="NoWrap" />

            <TextBlock x:Name="StatusText" Grid.Row="4" Text="就绪"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</ui:FluentWindow>