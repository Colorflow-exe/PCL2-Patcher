<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PCL2Patcher.Core</AssemblyName>
    <RootNamespace>PCL2Patcher.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\reference.gz" LogicalName="PCL2Patcher.Core.Resources.reference.gz" />
    <EmbeddedResource Include="Resources\PCLCS.dll" LogicalName="PCL2Patcher.Core.Resources.PCLCS.dll" />
    <EmbeddedResource Include="Resources\MeloongCore.dll" LogicalName="PCL2Patcher.Core.Resources.MeloongCore.dll" />
    <EmbeddedResource Include="Resources\MeloongCore.Wpf.dll" LogicalName="PCL2Patcher.Core.Resources.MeloongCore.Wpf.dll" />
    <EmbeddedResource Include="Resources\Microsoft.Win32.Registry.dll" LogicalName="PCL2Patcher.Core.Resources.Microsoft.Win32.Registry.dll" />
    <EmbeddedResource Include="Resources\Newtonsoft.Json.dll" LogicalName="PCL2Patcher.Core.Resources.Newtonsoft.Json.dll" />
  </ItemGroup>

</Project>